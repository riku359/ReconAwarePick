# Copy to .env at the repository root and fill it in. .env is git-ignored, and it is
# the only file in this repository that holds credentials. Every stage that talks to
# CryoSPARC reads it from here. See docs/CONFIGURATION.md and docs/CRYOSPARC.md.
#
# CryoSPARC is NOT installed by this repository. A free non-commercial licence id is
# enough; v4.7.x is required.

# --- CryoSPARC account (cryosparc_master/config.sh, and your own login) ---
CRYOSPARC_LICENSE_ID=
CRYOSPARC_EMAIL=
CRYOSPARC_PASSWORD=

# --- CryoSPARC master (config.sh: CRYOSPARC_MASTER_HOSTNAME / CRYOSPARC_BASE_PORT) ---
CRYOSPARC_HOST=localhost
CRYOSPARC_PORT=39000

# --- Where jobs run and where they land ---
# CRYOSPARC_WORKER is the name of your worker lane exactly as CryoSPARC reports it:
#   cryosparcm cli "get_scheduler_targets()"
# CRYOSPARC_PROJECT is the project uid this pipeline writes into, for example P1.
# Create it once in the CryoSPARC web interface; it is never hardcoded in a config file.
CRYOSPARC_WORKER=
CRYOSPARC_PROJECT=
