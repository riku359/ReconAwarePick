# Upstream code is fetched by scripts/setup.sh, never committed.
/third_party/

# Per-tool virtual environments, built from envs/<name>/ lockfiles.
# No trailing slash: on a machine whose code disk is small, .venv is a symlink
# onto the data disk, which a directory-only pattern would not match.
.venv
.venvs/
.uv-cache/
__pycache__/
*.pyc
# `uv sync` builds envs/recon's (empty) project and leaves this behind.
*.egg-info/

# Secrets. .env holds the CryoSPARC license id, e-mail and password;
# .env.example is the tracked template.
.env
.env.*
!.env.example

# Model weights and micrographs live under $RAPICK_DATA, run outputs under
# $RAPICK_WORK, both outside the repository (docs/CONFIGURATION.md). These
# patterns only guard against a root being pointed inside the clone.
*.pth
*.mrc
*.mrcs
*.star
/data/
/work/

!/assets/**

.DS_Store
*.log

# The submission bundle: the anonymous tree of the anonymize-for-review branch plus
# supp.pdf, built by hand and never part of the repository.
/*-supplementary.zip

# The regexes the anonymize-for-review branch's check_release.sh matches against:
# host names, account names, author names. Ignored on every branch so that it stays
# out of the release and out of this branch's own hygiene gate.
/.private-patterns
